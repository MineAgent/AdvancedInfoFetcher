#!/usr/bin/env bash
# aifetch - query the running Minecraft client for player info.
#
#   ./aifetch              player info (GET /aif/info)   [same as: ./aifetch info]
#   ./aifetch info         player info (GET /aif/info)
#   ./aifetch inventory    inventory / offhand / armor (GET /aif/inventory)
#   ./aifetch msg          chat lines since the previous msg call (GET /aif/msg)
#   ./aifetch sound        sounds played since the previous sound call (GET /aif/sound)
#   ./aifetch keysnd       only the noteworthy sounds since the previous call (GET /aif/keysnd)
#   ./aifetch world        dimension / time / weather (GET /aif/world)
#   ./aifetch help         full manual (GET /aif/)
#
# Environment:
#   AIFETCH_URL   default http://127.0.0.1:3420/aif
set -euo pipefail

URL="${AIFETCH_URL:-http://127.0.0.1:3420/aif}"

case "${1:-info}" in
	-h | --help | help)
		exec curl -sS "$URL/"
		;;
	info | player | "")
		curl -sS "$URL/info"
		;;
	inventory | inv | bag)
		curl -sS "$URL/inventory"
		;;
	msg | messages | chat)
		curl -sS "$URL/msg"
		;;
	sound | sounds | audio)
		curl -sS "$URL/sound"
		;;
	keysnd | keysounds | key)
		curl -sS "$URL/keysnd"
		;;
	world | dimension | time)
		curl -sS "$URL/world"
		;;
	*)
		echo "aifetch: unknown argument '$1' (use: info | inventory | msg | sound | keysnd | world | help)" >&2
		exit 2
		;;
esac
